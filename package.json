{
  "name": "asphalt-condensation-support",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "serve:test": "npm run build && node scripts/serve-dist.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "check:astro": "astro check",
    "check:content": "node scripts/validate-content.mjs",
    "check:dist": "node scripts/validate-dist.mjs",
    "check:format": "prettier --check .",
    "check:public": "node scripts/check-public-safety.mjs",
    "check": "npm run check:format && npm run check:public && npm run check:content && npm run check:astro && npm run build && npm run check:dist",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "new:app": "node .agents/skills/app-support-hub/scripts/scaffold-app.mjs"
  },
  "dependencies": {
    "astro": "7.2.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@kevz-labs/rocket": "0.1.2",
    "@lucide/astro": "1.34.0",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "gray-matter": "4.0.3",
    "linkedom": "0.18.12",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3"
  }
}
