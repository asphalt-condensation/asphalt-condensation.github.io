---
import { ArrowUpRight, Smartphone } from "@lucide/astro";
import { getCollection } from "astro:content";
import ParticleField from "../components/ParticleField.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const apps = (await getCollection("apps")).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);
const statusLabels = {
  available: "Available",
  "coming-soon": "Coming soon",
  retired: "Retired",
};
---

<BaseLayout
  title="Asphalt Condensation Support"
  description="Official support and privacy information for apps published by Asphalt Condensation."
  pageClass="hub-page"
>
  <section class="hub-stage">
    <ParticleField />
    <div class="hub-shell">
      <header class="hub-heading">
        <p class="hub-kicker">Support</p>
        <h1>Asphalt Condensation Apps</h1>
        <p>Choose an app to find the answer you need.</p>
      </header>

      <div class="app-grid" aria-label="Apps">
        {
          apps.map(({ data: app }) => (
            <article class="app-tile" style={`--app-accent: ${app.accent}`}>
              <a href={`/${app.slug}/`} aria-label={`${app.name} support`}>
                <div class="app-tile-topline">
                  <span>{statusLabels[app.status]}</span>
                  <ArrowUpRight aria-hidden="true" size={19} stroke-width={2} />
                </div>
                <div class="app-tile-art">
                  <img
                    src={app.icon}
                    alt={`${app.name} app icon`}
                    width="104"
                    height="104"
                  />
                </div>
                <div class="app-tile-copy">
                  <h2>{app.name}</h2>
                  <p>{app.summary}</p>
                  <span class="platforms">
                    <Smartphone
                      aria-hidden="true"
                      size={15}
                      stroke-width={2.1}
                    />
                    {app.platform.join(" / ")}
                  </span>
                </div>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
