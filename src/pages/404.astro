---
import { ArrowLeft } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found | Asphalt Condensation Support"
  description="The requested support page could not be found."
>
  <div class="not-found">
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p>The address may have changed, or the page may no longer be available.</p>
    <a class="primary-action" href="/">
      <ArrowLeft aria-hidden="true" size={17} stroke-width={2.2} />
      View all apps
    </a>
  </div>
</BaseLayout>
