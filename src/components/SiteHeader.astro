---
import { ChevronRight } from "@lucide/astro";

interface Props {
  currentApp?: string;
  locale?: string;
}

const { currentApp, locale = "en" } = Astro.props;
const homeLabel = locale === "zh-hans" ? "全部 App" : "All apps";
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Asphalt Condensation Support home">
      <img
        class="brand-mark"
        src="/favicon.svg"
        alt=""
        width="38"
        height="38"
      />
      <span class="brand-copy">
        <strong class="brand-full">Asphalt Condensation</strong>
        <strong class="brand-short">Asphalt</strong>
        <span>Support</span>
      </span>
    </a>
    {
      currentApp && (
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">{homeLabel}</a>
          <ChevronRight aria-hidden="true" size={15} stroke-width={2.2} />
          <span class="breadcrumb-current" aria-current="page">
            {currentApp}
          </span>
        </nav>
      )
    }
  </div>
</header>
