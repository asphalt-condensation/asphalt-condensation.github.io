---
import { ArrowLeft, Languages, LifeBuoy, ShieldCheck } from "@lucide/astro";

interface LocaleLink {
  code: string;
  label: string;
  href: string;
  current: boolean;
}

interface Props {
  name: string;
  summary: string;
  icon: string;
  platforms: string[];
  status: "available" | "coming-soon" | "retired";
  accent: string;
  localeLinks: LocaleLink[];
  supportHref: string;
  privacyHref: string;
  kind: "support" | "privacy";
  locale: string;
}

const {
  name,
  summary,
  icon,
  platforms,
  status,
  accent,
  localeLinks,
  supportHref,
  privacyHref,
  kind,
  locale,
} = Astro.props;

const zh = locale === "zh-hans";
const statusLabel = {
  available: zh ? "已发布" : "Available",
  "coming-soon": zh ? "即将发布" : "Coming soon",
  retired: zh ? "已停止维护" : "Retired",
}[status];
---

<section class="app-hero" style={`--app-accent: ${accent}`}>
  <a class="back-link" href="/">
    <ArrowLeft aria-hidden="true" size={16} stroke-width={2.1} />
    {zh ? "全部 App" : "All apps"}
  </a>

  <div class="app-identity">
    <div class="app-icon-frame">
      <img
        class="app-icon"
        src={icon}
        alt={`${name} app icon`}
        width="96"
        height="96"
      />
    </div>
    <div class="app-title-group">
      <div
        class="status-row"
        aria-label={zh ? "平台和状态" : "Platforms and status"}
      >
        <span class="status">{statusLabel}</span>
        <span>{platforms.join(" / ")}</span>
      </div>
      <h1>{name}</h1>
      <p>{summary}</p>
    </div>
  </div>

  <div class="app-controls">
    <nav class="section-tabs" aria-label={zh ? "页面" : "Page sections"}>
      <a
        href={supportHref}
        aria-current={kind === "support" ? "page" : undefined}
      >
        <LifeBuoy aria-hidden="true" size={16} stroke-width={2.1} />
        {zh ? "支持" : "Support"}
      </a>
      <a
        href={privacyHref}
        aria-current={kind === "privacy" ? "page" : undefined}
      >
        <ShieldCheck aria-hidden="true" size={16} stroke-width={2.1} />
        {zh ? "隐私" : "Privacy"}
      </a>
    </nav>
    <div class="language-control" aria-label={zh ? "语言" : "Language"}>
      <Languages aria-hidden="true" size={16} stroke-width={2} />
      <nav class="language-links" aria-label={zh ? "语言" : "Language"}>
        {
          localeLinks.map((item) => (
            <a
              href={item.href}
              lang={item.code}
              aria-current={item.current ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</section>
